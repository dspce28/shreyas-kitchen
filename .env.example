# ─────────────────────────────────────────────────────────────
#  Shreya's Kitchen — environment
#  Copy to .env.local and fill in. Never commit .env.local.
# ─────────────────────────────────────────────────────────────

# ── Supabase ──────────────────────────────────────────────────
# Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# service_role key. SERVER ONLY — never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ── Session ───────────────────────────────────────────────────
# Signing secret for the customer/admin session cookie.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# ── OTP delivery ──────────────────────────────────────────────
# dev      → OTP is returned in the API response and printed to the server log.
#            Nothing is sent. Use this until Meta approves your WhatsApp sender.
# whatsapp → sends via WhatsApp Cloud API using the template below.
OTP_PROVIDER=dev

# WhatsApp Cloud API (required only when OTP_PROVIDER=whatsapp)
# Meta for Developers → WhatsApp → API Setup
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
# Name of your APPROVED authentication-category template.
WHATSAPP_OTP_TEMPLATE=shreyas_kitchen_otp
WHATSAPP_OTP_TEMPLATE_LANG=en

# ── Razorpay ──────────────────────────────────────────────────
# Dashboard → Account & Settings → API Keys. Use rzp_test_* while building.
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard → Webhooks → the secret you set on the webhook endpoint.
RAZORPAY_WEBHOOK_SECRET=

# ── Store ─────────────────────────────────────────────────────
# Comma-separated admin phone numbers in E.164 (no spaces).
ADMIN_PHONES=+919601050241
# Delivery charge and free-delivery threshold, in rupees.
DELIVERY_FEE_RUPEES=30
FREE_DELIVERY_ABOVE_RUPEES=399
# Pincodes you deliver to, comma-separated. Empty = accept all.
DELIVERY_PINCODES=380015,380051,380054,380059,380060
